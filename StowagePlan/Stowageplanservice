    private sealed class PlanContext
    {
        public string PlanNo { get; init; } = "";
        public PlanRow? Plan { get; init; }
        public TripHeadRow? Trip { get; set; }
        public List<PlanContainerRow> Containers { get; set; } = new();
        public List<StowSiRow> Sis { get; set; } = new();
    }

    private async Task<PlanContext> LoadAsync(string planNo)
    {
        var no = Clean(planNo) ?? throw NotFound(planNo);

        if (await _repo.GetPlanAsync(no) is { } plan)
        {
            var ctx = new PlanContext { PlanNo = plan.PlanNo, Plan = plan };
            ctx.Containers = await _repo.GetContainersAsync(plan.Id);
            var planSis = await _repo.GetPlanSisAsync(plan.Id);

            if (ctx.Containers.FirstOrDefault(c => c.ContainerIndex == 0)?.TripId is { } tripId)
                ctx.Trip = await _repo.GetTripAsync(tripId);

            if (ctx.Trip is null)
            {
                ctx.Sis = planSis;
            }
            else
            {
                // SI sống theo chuyến, giữ màu đã lưu
                var colors = planSis.ToDictionary(s => s.SiId, s => s.Color);
                ctx.Sis = await _repo.GetTripSisAsync(ctx.Trip.Id);
                foreach (var s in ctx.Sis) s.Color = colors.GetValueOrDefault(s.SiId);
            }
            return ctx;
        }

        // Chuyến chưa lập sơ đồ: "VP-T{tripId}"
        var m = TripPlanNo.Match(no);
        if (!m.Success || !long.TryParse(m.Groups[1].Value, out var id))
            throw NotFound(no);

        var trip = await _repo.GetTripAsync(id)
            ?? throw NotFound(no);

        // Chuyến đã có plan mang số khác (vd plan lập theo order rồi gắn chuyến) -> mở plan đó
        if (await _repo.GetPlanNoOfTripAsync(id) is { } existing
            && !string.Equals(existing, no, StringComparison.OrdinalIgnoreCase))
            return await LoadAsync(existing);

        return new PlanContext
        {
            PlanNo = PlanNoOfTrip(id),
            Trip = trip,
            Sis = await _repo.GetTripSisAsync(id),
        };
    }

    private async Task<StowagePlanDto> BuildAsync(PlanContext ctx)
    {
        var mode = ModeOf(ctx);
        var boxes = await _repo.GetBoxesAsync(ctx.Sis.Select(s => s.SiId).ToList());
        var keys = BoxKeys(boxes);
        var siNo = ctx.Sis.ToDictionary(s => s.SiId, s => s.SiNo);

        var dto = new StowagePlanDto
        {
            PlanNo = ctx.Plan?.PlanNo ?? ctx.PlanNo,
            TripId = ctx.Trip?.Id,
            TripNo = ctx.Trip?.TripNo,
            UnitKind = UnitKindOf(ctx),
            UnitNo = UnitNoOf(ctx),
            ContainerType = ContainerTypeOf(ctx),
            Destination = DestinationOf(ctx) ?? "",
            Etd = ctx.Sis.Count > 0 ? ctx.Sis.Min(s => s.EtdDate) : ctx.Plan?.EtdDate,
            Forwarder = ForwarderOf(ctx),
            Mode = mode,
            BaseType = PlanBase(ctx, mode),
            Status = ParseStatus(ctx.Plan?.Status),
            ContainerCount = Math.Max(1, ctx.Containers.Count),
            Sis = ctx.Sis.Select(s => new StowageSiDto
            {
                SiNo = s.SiNo,
                Customer = s.ConsigneeCode ?? "",
                Color = string.IsNullOrWhiteSpace(s.Color) ? null : s.Color.Trim(),
                PackingType = Clean(s.PackingType),
                BaseType = BaseOfPacking(s.PackingType),
            }).ToList(),
            Boxes = boxes.Select(b => new StowageBoxDto
            {
                BoxNo = keys[b.Ident],
                SiNo = b.SiNo,
                Model = b.Model,
                Length = b.Length ?? 0,
                Width = b.Width ?? 0,
                Height = b.Height ?? 0,
                Weight = b.Weight ?? 0,
                LayerLimit = b.LayerLimit is > 0 ? b.LayerLimit : null,
                IsEstimated = b.IsEstimated,
            }).ToList(),
        };

        if (ctx.Plan is null) return dto;

        var columns = await _repo.GetColumnsAsync(ctx.Plan.Id);
        // Pallet của SI đã rời chuyến: bỏ (Web dựng lại cọc thiếu đáy)
        var pallets = (await _repo.GetPalletsAsync(ctx.Plan.Id)).Where(p => siNo.ContainsKey(p.SiId)).ToList();
        // Thùng đã lưu nhưng không còn trong danh sách (vd thùng dự kiến, nay đã lấy hàng thành box thật) -> bỏ
        var palletBoxes = (await _repo.GetPalletBoxesAsync(ctx.Plan.Id))
            .GroupBy(x => x.StowagePalletId)
            .ToDictionary(g => g.Key, g => g.Select(x => x.Ident).ToList());

        foreach (var p in pallets)
        {
            dto.Pallets.Add(new StowagePalletDto
            {
                PalletNo = Id(p.Id),
                Code = p.Code,
                SiNo = siNo[p.SiId],
                Size = p.PalletSize,
                PalletLength = p.LengthCm,
                PalletWidth = p.WidthCm,
                BoxNos = palletBoxes.GetValueOrDefault(p.Id)?
                    .Where(keys.ContainsKey).Select(b => keys[b]).ToList() ?? new(),
            });
        }

        var byColumn = pallets.ToLookup(p => p.ColumnId);
        foreach (var c in columns)
        {
            dto.Columns.Add(new StowageColumnDto
            {
                ColumnNo = Id(c.Id),
                Code = c.Code,
                BottomPalletNo = byColumn[c.Id].FirstOrDefault(p => p.Tier == 1) is { } b ? Id(b.Id) : null,
                TopPalletNo = byColumn[c.Id].FirstOrDefault(p => p.Tier == 2) is { } t ? Id(t.Id) : null,
            });

            if (c.ContainerIndex is { } ci && c.RowNo is { } row && c.LaneNo is { } lane)
                dto.Placements.Add(new StowagePlacementDto
                {
                    ContainerIndex = ci,
                    Row = row,
                    Lane = lane,
                    ColumnNo = Id(c.Id),
                    Rotated = c.Rotated,
                });
        }

        return dto;
    }

    // ═══════════════════════════════════════════════════════════════
    //  Helper
    // ═══════════════════════════════════════════════════════════════

    private static string PlanNoOfTrip(long tripId) => TripPlanPrefix + tripId.ToString(CultureInfo.InvariantCulture);

    private static string Id(long id) => id.ToString(CultureInfo.InvariantCulture);

    /// <summary>Khoá thùng gửi Web, theo Ident (định danh DB):
    ///   box thật     -> số box; số trùng giữa các SI của plan thì "{box_no}#{id}"
    ///   thùng dự kiến -> "{si_no}/{line_no}/{seq:000}" (vd MW202611N2/1/007)</summary>
    private static Dictionary<string, string> BoxKeys(List<StowBoxRow> boxes)
    {
        var dup = boxes.Where(b => b.BoxNo is not null)
            .GroupBy(b => b.BoxNo!, StringComparer.OrdinalIgnoreCase)
            .Where(g => g.Count() > 1)
            .Select(g => g.Key)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        return boxes.ToDictionary(b => b.Ident, b => b.SiBoxId is { } id
            ? (dup.Contains(b.BoxNo!) ? $"{b.BoxNo}#{id}" : b.BoxNo!)
            : string.Create(CultureInfo.InvariantCulture, $"{b.SiNo}/{b.LineNo}/{b.CartonSeq:000}"),
            StringComparer.Ordinal);
    }

    /// <summary>"FCL 40H" / "fcl" -> FCL; "TRUCK 5T" -> TRUCK. Không rõ -> FCL.
    /// Phải giống ShipModeRule.All bên Web.</summary>
    private static string NormalizeMode(string? shipMode)
    {
        var first = (shipMode ?? "").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()?.ToUpperInvariant();
        return first is "FCL" or "LCL" or "AIR" or "TRUCK" ? first : "FCL";
    }

    private static string ModeOf(PlanContext ctx)
        => ctx.Sis.Select(s => s.ShipMode).FirstOrDefault(m => !string.IsNullOrWhiteSpace(m)) is { } m
            ? NormalizeMode(m)
            : NormalizeMode(ctx.Plan?.ShipMode);

    /// <summary>Loại đơn vị theo chuyến: xe container -> CONT; xe tải AIR -> ULD; xe tải TRUCK -> TRUCK;
    /// xe tải LCL / khác -> LOT.</summary>
    private static string KindOf(string? vehicleType, string mode)
        => vehicleType == "container" ? "CONT" : mode switch { "AIR" => "ULD", "TRUCK" => "TRUCK", _ => "LOT" };

    /// <summary>Loại sàn để vẽ:
    ///   TRUCK bằng xe tải -> thùng xe theo cỡ xe của chuyến ("5T", "TRK-5T"…); chưa ghi / không nhận ra -> xe lớn nhất.
    ///   Còn lại -> cỡ cont của chuyến; xe tải chở AIR / LCL chưa ghi cỡ -> cont 40H như container thường
    ///   (hàng đóng tiếp vào cont / ULD ở CFS, sân bay).</summary>
    private static string TypeOf(string? vehicleType, string mode, string? size)
    {
        if (mode == "TRUCK" && vehicleType != "container")
            return (ContainerSpec.Truck(size) ?? ContainerSpec.LargestTruck).Code;
        return Clean(size) is { } s && !s.Contains("PMC", StringComparison.OrdinalIgnoreCase)
               && ContainerSpec.Truck(s) is null ? s : "40H";
    }

    private static string UnitKindOf(PlanContext ctx)
        => ctx.Trip is { } t ? KindOf(t.VehicleType, ModeOf(ctx)) : ctx.Plan?.UnitKind ?? "CONT";

    private static string ContainerTypeOf(PlanContext ctx)
        => ctx.Trip is { } t
            ? TypeOf(t.VehicleType, ModeOf(ctx), t.ContainerSize)
            : Clean(ctx.Plan?.ContainerType) ?? "40H";

    private static string? ForwarderOf(PlanContext ctx)
        => Clean(ctx.Trip?.ForwarderCode)
           ?? ctx.Sis.Select(s => Clean(s.ForwarderCode)).FirstOrDefault(x => x is not null)
           ?? Clean(ctx.Plan?.ForwarderCode);

    private static string? DestinationOf(PlanContext ctx)
        => ctx.Sis.Select(s => Clean(s.Destination)).FirstOrDefault(x => x is not null) ?? Clean(ctx.Plan?.Destination);

    private static string UnitNoOf(PlanContext ctx)
        => Clean(ctx.Trip?.ContainerNo)
           ?? Clean(ctx.Trip?.PlateNo)
           ?? Clean(ctx.Containers.FirstOrDefault(c => c.ContainerIndex == 0)?.UnitNo)
           ?? "—";

    private static StowageStatus ParseStatus(string? s) => s switch
    {
        "draft" => StowageStatus.Draft,
        "saved" => StowageStatus.Saved,
        _ => StowageStatus.NotStarted,
    };

    private static string ToDb(PalletBaseType t) => t switch
    {
        PalletBaseType.Wood => "wood",
        PalletBaseType.Plastic => "plastic",
        PalletBaseType.Loose => "loose",
        PalletBaseType.Paper => "paper",
        _ => "no_base",
    };

    private static PalletBaseType FromDb(string? s) => s switch
    {
        "wood" => PalletBaseType.Wood,
        "plastic" => PalletBaseType.Plastic,
        "loose" => PalletBaseType.Loose,
        "paper" => PalletBaseType.Paper,
        _ => PalletBaseType.NoBase,
    };

    /// <summary>Phải giống StowageWorkspace.BaseWeightOf bên Web.</summary>
    private static double BaseWeight(PalletBaseType t) => t switch
    {
        PalletBaseType.Wood => 20,
        PalletBaseType.Plastic => 12,
        PalletBaseType.Paper => 5,
        _ => 0,
    };

    /// <summary>Packing type trên SI -> loại đế. Không nhận ra -> null (dùng đế mặc định theo hình thức).
    ///   PLASTIC PALLET -> Plastic · Paper pallet -> Paper · SLIP SHEET -> NoBase (tấm lót)
    ///   CARTON BOX / Double Carton -> Loose (thùng rời, không đế) · có chữ WOOD -> Wood</summary>
    private static PalletBaseType? BaseOfPacking(string? packingType)
    {
        var t = string.Join(' ', (packingType ?? "").ToUpperInvariant()
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
        if (t.Length == 0) return null;
        if (t.Contains("PLASTIC")) return PalletBaseType.Plastic;
        if (t.Contains("PAPER")) return PalletBaseType.Paper;
        if (t.Contains("SLIP")) return PalletBaseType.NoBase;
        if (t.Contains("WOOD")) return PalletBaseType.Wood;
        if (t.Contains("CARTON")) return PalletBaseType.Loose;      // CARTON BOX, DOUBLE CARTON
        return null;
    }

    private static PalletBaseType DefaultBase(string mode) => mode == "AIR" ? PalletBaseType.Plastic : PalletBaseType.NoBase;

    /// <summary>Đế chung của plan (lưu header / SI không ghi packing type): loại đế nhiều SI dùng nhất.</summary>
    private static PalletBaseType PlanBase(PlanContext ctx, string mode)
        => ctx.Sis.Select(s => BaseOfPacking(s.PackingType))
               .Where(b => b is not null)
               .GroupBy(b => b!.Value)
               .OrderByDescending(g => g.Count())
               .Select(g => (PalletBaseType?)g.Key)
               .FirstOrDefault()
           ?? (ctx.Plan is not null ? FromDb(ctx.Plan.BaseType) : DefaultBase(mode));

    private BusinessRuleException Bad(string key, params object[] args) => new(_localizer[key, args]);

    private NotFoundException NotFound(string? planNo) => new(_localizer["StowagePlan.NotFound", planNo ?? ""]);

    private static string? Clean(string? v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();
